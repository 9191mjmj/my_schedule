{
  "name": "cug-schedule",
  "version": "1.0.0",
  "description": "中国地质大学（武汉）桌面课表应用",
  "author": "CUG",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cug.schedule",
    "productName": "地大课表",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "地大课表"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "美化课表1.html",
      "index.html",
      "package.json"
    ]
  }
}
